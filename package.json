{
  "name": "memo-cook",
  "version": "0.1.0",
  "description": "Explicit, traceable memory outboard for agents using Markdown, SQLite FTS, CLI, and MCP.",
  "type": "module",
  "bin": {
    "memo-cook": "./dist/cli.js"
  },
  "files": [
    "dist",
    "plugins",
    "integrations",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eval": "tsx eval/run-eval.ts",
    "dev": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "agent-memory",
    "mcp",
    "markdown",
    "notes",
    "fts"
  ],
  "author": "Memo Cook",
  "homepage": "https://github.com/ken0122/memo-cook#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ken0122/memo-cook.git"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "gray-matter": "^4.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
